# Copy to .env.local for local dev, or set these in your hosting provider.

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL=https://jojocloud.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
NEXT_PUBLIC_DOMAIN=jojocloud.com

# --- Server-only secrets (never exposed to the browser) ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

PAYMOB_API_KEY=xxx
PAYMOB_INTEGRATION_ID=xxx
PAYMOB_IFRAME_ID=xxx
PAYMOB_HMAC_SECRET=xxx

# --- Internal service-to-service call to the Python Provisioner (Step 3) ---
PROVISIONER_INTERNAL_URL=http://provisioner:8000
PROVISIONER_INTERNAL_TOKEN=change_me_shared_secret_between_nextjs_and_provisioner
